# Placeholder values only. Do not put real secrets in this file.

# PostgreSQL connection string. Phase 1 does not require a live database.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/biapay

# Auth.js / next-auth secret for future admin sessions. Generate a long random string.
# next-auth 4 reads NEXTAUTH_SECRET. AUTH_SECRET is accepted for a later Auth.js v5 move.
AUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Public origin of this marketing site. Not the payment gateway.
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
